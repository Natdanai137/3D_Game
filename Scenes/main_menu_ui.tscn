initial_position = 2
size = Vector2i(540, 350)
unresizable = true
dialog_text = "W A S D   เดิน\nShift   วิ่ง\nSpace   กระโดดต่อกันได้ 3 ครั้ง ลงพื้นแล้วคืนครบ\nเมาส์   หมุนกล้องบุคคลที่สาม\nR   กลับเช็กพอยต์ล่าสุด\nEsc   ปล่อยเมาส์ คลิกในฉากเพื่อกลับมาควบคุม\n\nยืนบนวงเช็กพอยต์ข้าง UncleOli เพื่อบันทึกจุด\nตกพ้นโลกแล้วกลับจุดล่าสุด ปีนไปให้ถึงปลายทาง"
